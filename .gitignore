# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Secrets
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

# Datasets and serialized objects
*.csv
*.pkl
*.pickle
*.npz
*.npy

# Model checkpoints and tensors
*.pt
*.pth
*.ckpt

# Generated outputs
outputs/checkpoints/*
outputs/metrics/*
outputs/samples/*
outputs/logs/*
wandb/
runs/

# Keep output folders
!outputs/checkpoints/.gitkeep
!outputs/metrics/.gitkeep
!outputs/samples/.gitkeep
!outputs/logs/.gitkeep

# SLURM
slurm-*.out
slurm-*.err

# Editors and operating system
.vscode/
.idea/
.DS_Store
